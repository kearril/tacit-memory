# The shared basics every editor and formatter reads: Prettier for the web app, dotnet format for C#.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,mjs,json,css,html,yml,yaml}]
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf

[*.cs]
# File-scoped namespaces, System usings first in one block.
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
# Short object initializers may keep several members on one line.
csharp_new_line_before_members_in_object_initializers = false
csharp_new_line_before_members_in_anonymous_types = false
