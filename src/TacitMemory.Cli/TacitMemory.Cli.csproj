<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tacit</AssemblyName>
    <RootNamespace>TacitMemory.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ConsoleAppFramework" Version="5.8.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TacitMemory.Core\TacitMemory.Core.csproj" />
    <ProjectReference Include="..\TacitMemory.Host\TacitMemory.Host.csproj" />
  </ItemGroup>

  <!--
    The web interface is built only when the project is published, and only then does it need Bun. Setting
    TacitSkipWebBuild=true publishes without it: no Bun is needed, and the publish directory has no web folder.
    The built files are copied to the web folder beside the executable, where the service reads them.
  -->
  <PropertyGroup>
    <TacitSkipWebBuild Condition="'$(TacitSkipWebBuild)' == ''">false</TacitSkipWebBuild>
    <TacitWebDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\web\'))</TacitWebDir>
  </PropertyGroup>

  <Target Name="TacitWebBuild" BeforeTargets="Publish" Condition="'$(TacitSkipWebBuild)' != 'true'">
    <Exec Command="bun --version" ContinueOnError="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="TacitBunExitCode" />
    </Exec>
    <Error Condition="'$(TacitBunExitCode)' != '0'"
           Text="Bun was not found on PATH, and the web interface needs it to be built. Install Bun (https://bun.sh), or publish without the web interface with /p:TacitSkipWebBuild=true. 找不到 Bun：构建 Web 界面需要 Bun，请安装 Bun，或加上 /p:TacitSkipWebBuild=true 跳过 Web 界面。" />
    <Exec Command="bun install --frozen-lockfile" WorkingDirectory="$(TacitWebDir)" />
    <Exec Command="bun run build" WorkingDirectory="$(TacitWebDir)" />
  </Target>

  <!--
    The web folder of the publish directory is removed first, so a file from an earlier publish never stays beside the
    new build; a publish that skips the web interface therefore leaves no web folder at all.
  -->
  <Target Name="TacitWebCopy" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)web" />
    <ItemGroup Condition="'$(TacitSkipWebBuild)' != 'true'">
      <TacitWebFile Include="$(TacitWebDir)dist\**\*" />
    </ItemGroup>
    <Copy Condition="'$(TacitSkipWebBuild)' != 'true'" SourceFiles="@(TacitWebFile)" DestinationFiles="@(TacitWebFile->'$(PublishDir)web\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
