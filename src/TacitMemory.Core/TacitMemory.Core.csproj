<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="SimpleExec" Version="13.1.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TacitMemory.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The official sqlite-vec release; its SHA-256 is checked before every load. SQLite loads it by its path, so the
      single-file release keeps it beside the executable instead of bundling it.
    -->
    <None Include="..\..\lib\sqlite-vec\vec0.dll" Link="vec0.dll" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
  </ItemGroup>

</Project>
