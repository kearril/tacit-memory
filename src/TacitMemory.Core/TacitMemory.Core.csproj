<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="SimpleExec" Version="13.1.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TacitMemory.Core.Tests" />
  </ItemGroup>

  <!--
    The official sqlite-vec release for the machine doing the build, so a plain build or test run anywhere can load it; its
    SHA-256 is checked before every load. A publish for another runtime swaps in that runtime's release (see the Cli
    project), since a referenced project is not built for the runtime being published.
  -->
  <ItemGroup>
    <None Include="..\..\lib\sqlite-vec\$(NETCoreSdkRuntimeIdentifier)\vec0.*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!--
    An SDK built by a Linux distribution can name its runtime after the distribution (ubuntu.24.04-x64), which matches no
    folder. Fail the build then, rather than leave a service that refuses to start for want of the extension.
  -->
  <Target Name="TacitVectorExtensionForBuild" BeforeTargets="Build">
    <ItemGroup>
      <TacitVectorFile Include="..\..\lib\sqlite-vec\$(NETCoreSdkRuntimeIdentifier)\vec0.*" />
    </ItemGroup>
    <Error Condition="'@(TacitVectorFile)' == ''" Text="No sqlite-vec release for $(NETCoreSdkRuntimeIdentifier) under lib/sqlite-vec. Build with Microsoft's .NET SDK, whose runtime identifiers are win-x64, osx-arm64 and linux-x64." />
  </Target>

</Project>
