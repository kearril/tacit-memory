  "components": {
    "schemas": {
      "AccessPasswordBody": {
        "required": [
          "password"
        ],
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          },
          "current": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ActivityDay": {
        "required": [
          "day",
          "workstreams",
          "unlabeled"
        ],
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "format": "date"
          },
          "workstreams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkstreamCount"
            }
          },
          "unlabeled": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ActivityReport": {
        "required": [
          "from",
          "to",
          "days",
          "consolidationDays",
          "skippedFiles",
          "historyUnreadable"
        ],
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActivityDay"
            }
          },
          "consolidationDays": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date"
            }
          },
          "skippedFiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "historyUnreadable": {
            "type": "boolean"
          }
        }
      },
      "ApiError": {
        "required": [
          "error",
          "message"
        ],
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "BackupBody": {
        "required": [
          "target"
        ],
        "type": "object",
        "properties": {
          "target": {
            "$ref": "#/components/schemas/BackupTarget"
          },
          "to": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "BackupResult": {
        "required": [
          "location",
          "bytes",
          "report",
          "notice"
        ],
        "type": "object",
        "properties": {
          "location": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "format": "int64"
          },
          "report": {
            "type": "string"
          },
          "notice": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "BackupsStatus": {
        "required": [
          "title",
          "lines",
          "latest",
          "latestAt",
          "lastRemote"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "latest": {
            "type": [
              "null",
              "string"
            ]
          },
          "latestAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastRemote": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CloudBackupRecord"
              }
            ]
          }
        }
      },
      "BackupTarget": {
        "enum": [
          "local",
          "remote"
        ]
      },
      "BindingCheck": {
        "required": [
          "client",
          "contextFile",
          "skillsFolder",
          "problem",
          "skillLink",
          "sharedWith"
        ],
        "type": "object",
        "properties": {
          "client": {
            "type": "string"
          },
          "contextFile": {
            "type": "string"
          },
          "skillsFolder": {
            "type": "string"
          },
          "problem": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/BindingProblem"
              }
            ]
          },
          "skillLink": {
            "type": [
              "null",
              "string"
            ]
          },
          "sharedWith": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "BindingProblem": {
        "enum": [
          "contextFileMissing",
          "contextFileNotUtf8",
          "contextFileUnreadable",
          "markersIncomplete",
          "skillLinkNotTacit",
          null
        ]
      },
      "BindingsStatus": {
        "required": [
          "title",
          "lines",
          "items"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BindingCheck"
            }
          }
        }
      },
      "ClientsStatus": {
        "required": [
          "title",
          "lines",
          "items"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClientStatus"
            }
          }
        }
      },
      "ClientStatus": {
        "required": [
          "name",
          "lastSeen",
          "protocolVersion",
          "capabilities",
          "extensions"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "lastSeen": {
            "type": "string",
            "format": "date"
          },
          "protocolVersion": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
