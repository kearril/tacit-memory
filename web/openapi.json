    "/api/restore": {
      "post": {
        "tags": [
          "management"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestoreBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "required": [
                        "path",
                        "generatedAt",
                        "tacitVersion",
                        "kind",
                        "memoryHead",
                        "memoryHeadSubject",
                        "fileCount",
                        "config",
                        "replaces",
                        "reportLines",
                        "prompt",
                        "cancelled"
                      ],
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "generatedAt": {
                          "type": [
                            "null",
                            "string"
                          ],
                          "format": "date-time"
                        },
                        "tacitVersion": {
                          "type": [
                            "null",
                            "string"
                          ]
                        },
                        "kind": {
                          "type": [
                            "null",
                            "string"
                          ]
                        },
                        "memoryHead": {
                          "type": "string"
                        },
                        "memoryHeadSubject": {
                          "type": [
                            "null",
                            "string"
                          ]
                        },
                        "fileCount": {
                          "type": "integer",
                          "format": "int32"
                        },
                        "config": {
                          "type": "boolean"
                        },
                        "replaces": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "reportLines": {
                          "type": "array",
                          "items": {
                            "required": [
                              "text",
                              "replaces"
                            ],
                            "type": "object",
                            "properties": {
                              "text": {
                                "type": "string"
                              },
                              "replaces": {
                                "type": "boolean"
                              }
                            }
                          }
                        },
                        "prompt": {
                          "type": "string"
                        },
                        "cancelled": {
                          "type": "string"
                        },
                        "report": {
                          "type": [
                            "null",
                            "string"
                          ]
                        }
                      }
                    },
                    {
                      "required": [
                        "safetyBackup",
                        "memoryHead",
                        "reindex",
                        "notices",
                        "report"
                      ],
                      "type": "object",
                      "properties": {
                        "safetyBackup": {
                          "type": "string"
                        },
                        "memoryHead": {
                          "type": "string"
                        },
                        "reindex": {
                          "required": [
                            "files",
                            "units",
                            "vectors",
                            "skippedFiles",
                            "vectorsPending",
                            "elapsedMilliseconds",
                            "report"
                          ],
                          "type": "object",
                          "properties": {
                            "files": {
                              "type": "integer",
                              "format": "int32"
                            },
                            "units": {
                              "type": "integer",
                              "format": "int32"
                            },
                            "vectors": {
                              "type": "integer",
                              "format": "int32"
                            },
                            "skippedFiles": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "vectorsPending": {
                              "type": "boolean"
                            },
                            "elapsedMilliseconds": {
                              "type": "integer",
                              "format": "int64"
                            },
                            "report": {
                              "type": "string"
                            }
                          }
                        },
                        "notices": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "report": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
